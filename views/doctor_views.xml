<odoo>

    <!-- Doctor List View -->
    <record id="view_doctor_list" model="ir.ui.view">
        <field name="name">hospital.doctor.list</field>
        <field name="model">res.partner</field>

        <field name="arch" type="xml">
            <list>
                <field name="doctor_code"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="fees"/>
                <field name="state_id"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>

    <!-- Doctor Form View -->
    <record id="view_doctor_form" model="ir.ui.view">
        <field name="name">hospital.doctor.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>

        <field name="arch" type="xml">

             <!-- Hide Person / Company -->
    <xpath expr="//field[@name='company_type']" position="attributes">
        <attribute name="invisible">1</attribute>
    </xpath>

    <!-- Doctor Code above Name -->
    <xpath expr="//field[@name='name']" position="before">
        <h1>
            <field name="doctor_code" readonly="1"/>
        </h1>
    </xpath>

            <!-- Replace full sheet -->
            <xpath expr="//sheet//group" position="replace">

                <sheet>

                    <!-- Smart Button -->
                    <div class="oe_button_box" name="button_box">

                        <button name="action_doctor_appointments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar">

                            <field name="appointment_count"
                                   widget="statinfo"
                                   string="Appointments"/>

                        </button>

                    </div>

                    <group>

                        <!-- Contact Information -->
                        <group string="Contact Information">

                            <field name="name"/>
                            <field name="phone"/>
                            <field name="email"/>

                            <field name="country_id"
                                   options="{'no_create': True}"/>

                            <field name="state_id"
                                   options="{'no_create': True}"/>

                            <field name="city"/>

                        </group>

                        <!-- Doctor Information -->
                        <group string="Doctor Information">

                            <field name="doctor_code" readonly="1"/>
                            <field name="specialization"/>
                            <field name="fees"/>

                        </group>

                    </group>

                </sheet>

            </xpath>

        </field>

    </record>

</odoo>