<odoo>

    <!-- Appointment Sequence -->
    <record id="seq_appointment_code" model="ir.sequence">
        <field name="name">Appointment Code</field>
        <field name="code">appointment.code</field>
        <field name="prefix">APT</field>
        <field name="padding">4</field>
    </record>

    <!-- Appointment List View -->
    <record id="view_appointment_list" model="ir.ui.view">
        <field name="name">hospital.appointment.list</field>
        <field name="model">hospital.appointment</field>

        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="fees"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- Appointment Form View -->
    <record id="view_appointment_form" model="ir.ui.view">
        <field name="name">hospital.appointment.form</field>
        <field name="model">hospital.appointment</field>

        <field name="arch" type="xml">
            <form string="Appointment">

                <header>

                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="status != 'draft'"/>

                    <button name="action_done"
                            string="Done"
                            type="object"
                            class="btn-success"
                            invisible="status != 'confirmed'"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-danger"
                            invisible="status not in ['draft','confirmed']"/>

                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,done,cancel"/>

                </header>

                <sheet>

                    <group>

                        <group string="Appointment Details">

                            <field name="code" readonly="1"/>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="appointment_date"/>
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="fees"/>

                        </group>

                        <group string="Notes">
                            <field name="notes"/>
                        </group>

                    </group>

                </sheet>

            </form>
        </field>
    </record>

</odoo>