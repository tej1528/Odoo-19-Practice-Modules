<odoo>

    <!-- ===================== -->
    <!-- LIST VIEW -->
    <!-- ===================== -->
    <record id="view_specialization_list" model="ir.ui.view">
        <field name="name">hospital.specialization.list</field>
        <field name="model">hospital.specialization</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="doctor_count"/>
                <field name="patient_count"/>
            </list>
        </field>
    </record>

    <!-- ===================== -->
    <!-- FORM VIEW -->
    <!-- ===================== -->
    <record id="view_specialization_form" model="ir.ui.view">
        <field name="name">hospital.specialization.form</field>
        <field name="model">hospital.specialization</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="doctor_count" readonly="1"/>
                        <field name="patient_count" readonly="1"/>
                    </group>

                    <notebook>

                        <!-- Doctors -->
                        <page string="Doctors">
                            <field name="doctor_ids" readonly="1" options="{'no_create': True, 'no_create_edit': True}">
                                <list>
                                    <field name="name"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================== -->
    <!-- ACTION -->
    <!-- ===================== -->
    <record id="action_specialization" model="ir.actions.act_window">
        <field name="name">Specializations</field>
        <field name="res_model">hospital.specialization</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>