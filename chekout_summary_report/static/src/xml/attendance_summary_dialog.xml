<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="chekout_summary_report.AttendanceSummaryDialog">
        <Dialog title.translate="Today's Summary">
            <div class="o_attendance_summary p-3">
                <!-- Greeting -->
                <div class="mb-4">
                    <h4 class="fw-bold mb-2">
                        Hello, <span t-esc="props.summary.employee"/>
                    </h4>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted">Worked Time :</span>
                        <strong class="fs-5" t-esc="props.summary.worked_time"/>
                    </div>
                </div>
                <!-- Attendance -->
                <div class="border rounded p-3 mb-4">
                    <div class="border-bottom pb-2 mb-3">
                        <h6 class="fw-bold text-primary mb-0">
                            <i class="fa fa-clock-o me-2"/>
                            Today's Attendance
                        </h6>
                    </div>
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Check In</th>
                                <th>Check Out</th>
                                <th>Worked</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="props.summary.attendance_sessions"
                               t-as="session"
                               t-key="session.check_in">
                                <tr>
                                    <td t-esc="session.check_in"/>
                                    <td t-esc="session.check_out or '-'"/>
                                    <td>
                                        <strong t-esc="session.worked"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                
                <!-- Timesheet -->
                <div class="border rounded p-3 mb-4">
                    <div class="border-bottom pb-2 mb-3">
                        <h6 class="fw-bold text-primary mb-0">
                            <i class="fa fa-list-alt me-2"/>
                            Today's Timesheet
                        </h6>
                    </div>
                    <t t-if="props.summary.activities.length">
                        <t t-foreach="props.summary.activities"
                        t-as="activity"
                        t-key="activity.id">
                            <div class="mb-3">
                                <!-- Description -->
                                <div class="d-flex align-items-start mb-3">
                                <strong style="margin-right:6px;">
                                    Description :
                                </strong>
                                <div style="flex:1;
                                            white-space:normal;
                                            word-break:break-word;
                                            overflow-wrap:anywhere;"
                                    t-esc="activity.description"/>
                            </div>
                                <!-- Details -->
                                <div class="row">
                                    <div class="col-4">
                                        <small class="text-muted d-block">
                                            Project
                                        </small>
                                        <strong t-esc="activity.project"/>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted d-block">
                                            Task
                                        </small>
                                        <strong t-esc="activity.task"/>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted d-block">
                                            Hours
                                        </small>
                                        <strong t-esc="activity.hours"/>
                                    </div>
                                </div>
                            </div>
                            <hr t-if="!activity_last"/>
                        </t>
                    </t>
                    <t t-else="">
                        <div class="alert alert-secondary text-center mb-0">
                            No activities logged today.
                        </div>
                    </t>
                </div>

                <!-- Tomorrow -->
                <div class="border rounded p-3">
                    <div class="border-bottom pb-2 mb-3">
                        <h6 class="fw-bold text-primary mb-0">
                            <i class="fa fa-calendar me-2"/>
                            Tomorrow
                        </h6>
                    </div>
                    <div class="alert alert-info mb-0">
                        <!-- If Leave Exists -->
                        <t t-if="props.summary.tomorrow.leaves.length">
                            <t t-foreach="props.summary.tomorrow.leaves"
                            t-as="leave"
                            t-key="leave.type + leave.period">
                                <div class="mb-3">
                                    <div>
                                        <strong>Leave : </strong>
                                        <span t-esc="leave.type"/>
                                    </div>
                                    <div>
                                        <strong>Leave Period : </strong>
                                        <span t-esc="leave.period"/>
                                    </div>
                                </div>
                                <hr t-if="!leave_last"/>
                            </t>
                            <div class="mt-3">
                                <span t-esc="props.summary.tomorrow.good_message"/>
                            </div>
                        </t>

                        <t t-else="">
                            <div class="fw-bold"
                                t-esc="props.summary.tomorrow.message"/>
                            <div class="mt-2"
                                t-esc="props.summary.tomorrow.good_message"/>
                        </t>
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="props.close"> Cancel </button>
                <button class="btn btn-warning" t-on-click="checkout">
                    Check Out
                </button>
            </t>
        </Dialog>
    </t>
</templates>