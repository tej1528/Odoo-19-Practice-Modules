<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="size_chart_editor_option"
              inherit_id="website_sale.product_page"
              name="Website Size Chart Option">

        <xpath expr="//we-checkbox[@data-customize-website-views='website_sale.product_comments']"
               position="after">

            <we-checkbox string="Size Chart"
                         data-select-class="d-none"
                         data-target=".o_wsale_size_chart"/>

        </xpath>

    </template>

</odoo>