<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Size Chart list View -->
    <record id="view_product_size_chart_tree" model="ir.ui.view">
        <field name="name">product.size.chart.list</field>
        <field name="model">product.size.chart</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Size Chart Form View -->
    <record id="view_product_size_chart_form" model="ir.ui.view">
        <field name="name">product.size.chart.form</field>
        <field name="model">product.size.chart</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description" widget="html"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_product_size_chart" model="ir.actions.act_window">
        <field name="name">Size Charts</field>
        <field name="res_model">product.size.chart</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_product_size_chart"
        name="Size Charts"
        parent="website_sale.menu_catalog"
        action="action_product_size_chart"
        sequence="30"
    />

    <!-- Product Template Inherit -->
    <record id="product_template_form_inherit_size_chart" model="ir.ui.view">
        <field name="name">product.template.form.size.chart</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="size_chart_id"/>
            </xpath>
        </field>
    </record>

    <!-- Website Product -->
    <template
        id="website_sale_product_size_chart"
        inherit_id="website_sale.product"
        name="Website Product Size Chart"
        customize_show="True"
        active="True">

        <xpath expr="//div[contains(@t-attf-class,'o_wsale_product_details_content_section_attributes')]"
            position="after">

            <t t-if="product.size_chart_id">
                <div class="o_wsale_product_details_content_section mb-3 o_wsale_size_chart">
                    <a href="#"
                    class="text-decoration-none"
                    data-bs-toggle="modal"
                    data-bs-target="#sizeChartModal">
                        <i class="fa fa-ruler me-1"/>
                        Size Chart
                    </a>
                </div>
            </t>

        </xpath>

    </template>

    <!-- Website Modal -->
    <template id="size_chart_modal_global" inherit_id="website.layout">
        <xpath expr="//body" position="inside">
            <t t-if="product and product.size_chart_id">
                <div class="modal fade" id="sizeChartModal" tabindex="-1" aria-labelledby="sizeChartModalLabel" aria-hidden="true" style="z-index: 99999 !important;">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="sizeChartModalLabel">
                                    <t t-esc="product.size_chart_id.name"/>
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                            </div>
                            <div class="modal-body">
                                <t t-out="product.size_chart_id.description"/>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

</odoo>