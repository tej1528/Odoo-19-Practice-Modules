<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_order_form_discount_inherit"
            model="ir.ui.view">

        <field name="name">pos.order.form.discount.inherit</field>

        <field name="model">pos.order</field>

        <field name="inherit_id"
               ref="point_of_sale.view_pos_pos_form"/>

        <field name="arch"
               type="xml">

            <!-- Untaxed Amount -->

            <xpath expr="//group[@name='order_total']/field[@name='amount_tax']"
                   position="before">

                <field name="amount_untaxed"
                       string="Untaxed Amount"
                       widget="monetary"
                       readonly="1"/>

            </xpath>

            <!-- Discount -->

            <xpath expr="//group[@name='order_total']/field[@name='amount_total']"
                   position="before">

                <field name="discount_display"
                       string="Discount"
                       readonly="1"/>

            </xpath>

        </field>

    </record>

</odoo>