<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t
        t-name="pos_changes.DiscountPopup"
    >

        <Dialog
            size="'md'"
            title="'Apply Discount'"
        >

            <div class="p-3">

                <div class="mb-3">

                    <label class="form-label">

                        Discount (%)

                    </label>

                    <input
                        type="number"
                        class="form-control"
                        placeholder="Enter %"
                        t-model="state.percent"
                    />

                </div>

                <div class="mb-3">

                    <label class="form-label">

                        Discount Amount

                    </label>

                    <input
                        type="number"
                        class="form-control"
                        placeholder="Enter amount"
                        t-model="state.amount"
                    />

                </div>

            </div>

            <t t-set-slot="footer">

                <button
                    class="btn btn-secondary"
                    t-on-click="cancel"
                >

                    Cancel

                </button>

                <button
                    class="btn btn-primary"
                    t-on-click="confirm"
                >

                    Apply

                </button>

            </t>

        </Dialog>

    </t>

</templates>