<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderReceipt"
   t-inherit-mode="extension">

    <xpath expr="//div[hasclass('receipt-total')]"
           position="before">

        <t t-if="props.order.global_discount_amount > 0">

            <div class="pos-receipt-amount d-flex justify-content-between">
    <span>Discount</span>

    <span>
        -<t t-esc="formatCurrency(props.order.global_discount_amount)"/>
    </span>
</div>

        </t>

    </xpath>

</t>
</templates>