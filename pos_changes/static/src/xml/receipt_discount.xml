<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt-amount')][2]"
               position="after">
            <t t-if="props.data.global_discount_amount > 0">
                <div class="pos-receipt-amount">
                    <span>Discount</span>
                    <span class="text-danger">
                        -
                        <t t-esc="env.utils.formatCurrency(props.data.global_discount_amount)"/>
                    </span>
                </div>
            </t>
        </xpath>
    </t>
</templates>