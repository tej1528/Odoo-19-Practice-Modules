<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'cashier')]" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>
        <xpath expr="//div[contains(@class, 'pos-receipt-contact')]" position="inside">
            <t t-if="this.cashierName">
                <div style="text-align:center; font-size:11px;">
                    Served By: <t t-esc="this.cashierName"/>
                </div>
            </t>
        </xpath>
    </t>
</templates>