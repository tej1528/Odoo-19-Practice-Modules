<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.ReceiptHeader"
       t-inherit-mode="extension">

        <xpath expr="//div[contains(@class,'cashier')]"
               position="replace">

            <t t-if="props.data.cashier">

                <div class="cashier">

                    Served by:
                    <t t-esc="props.data.cashier"/>

                </div>

            </t>

        </xpath>

    </t>

</templates>