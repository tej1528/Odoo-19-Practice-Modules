<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">

        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/button[hasclass('o_pricelist_button')]"
               position="before">

            <button
                class="js_discount_custom"
                t-att-class="buttonClass"
                t-on-click="clickCustomDiscount">

                <i class="fa fa-tag me-1"/>
                Discount cus

            </button>

        </xpath>

    </t>

</templates>