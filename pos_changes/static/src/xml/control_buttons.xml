<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'control-buttons-modal')]" position="inside">

            <button t-att-class="buttonClass"
                    t-on-click="openAmountDiscountPopup">

                <i class="fa fa-percent me-1"/>
                Discount

            </button>

        </xpath>
    </t>

</templates>