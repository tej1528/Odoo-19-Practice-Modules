<odoo>
    <template id="report_appointment_pdf">

        <!-- ✅ MUST -->
        <t t-call="web.html_container">

            <!-- ✅ MUST -->
            <t t-call="web.html_container">
                <t t-call="web.external_layout">

                    <div class="page">

                    <style>
                        table {
                            font-size: 12px;
                        }
                        thead {
                            display: table-header-group;
                        }
                    </style>

                        <h2>Appointment Report</h2>

                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Code</th>
                                    <th>Patient</th>
                                    <th>Doctor</th>
                                    <th>Specialization</th>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Fees</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                <t t-set="i" t-value="0"/>
                                <t t-foreach="docs" t-as="rec">
                                    <tr>
                                        <!-- <td><t t-set="i" t-value="i + 1"/></td> -->
                                        <td><t t-esc="(i or 0) + 1"/></td>
                                        <td><t t-esc="rec.code"/></td>
                                        <td><t t-esc="rec.patient_id.name"/></td>
                                        <td><t t-esc="rec.doctor_id.name"/></td>
                                        <td><t t-esc="rec.specialization_id.name"/></td>
                                        <td><t t-esc="context_timestamp(rec.start_time).strftime('%d/%m/%Y') if rec.start_time else ''"/></td>
                                        <td><t t-esc="context_timestamp(rec.start_time).strftime('%I:%M %p')"/> to
                                            <t t-esc="context_timestamp(rec.end_time).strftime('%I:%M %p')"/>
                                        </td>
                                        <td><t t-esc="rec.fees"/></td>
                                        <td><t t-esc="rec.status"/></td>                                        
                                    </tr>
                                    <t t-set="i" t-value="i + 1"/>
                                </t>
                            </tbody>
                        </table>

                    </div>

                </t>
            </t>

        </t>

    </template>
</odoo>