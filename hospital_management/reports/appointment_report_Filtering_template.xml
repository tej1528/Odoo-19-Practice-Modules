<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_appointment_pdf">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">

                <div class="page" style="font-family: 'Helvetica', sans-serif; color: #333;">

                    <style>
                        .text-right { text-align: right; }

                        /* HEADER BOX */
                        .header-box {
                            margin-top: 10px;
                            margin-bottom: 15px;
                        }

                        .header-box table {
                            width: 100%;
                            border-collapse: collapse;
                           
                        }

                        .header-box td {
                            vertical-align: middle;
                        }

                        /* TABLE STYLING */
                        .appointment-table {
                            width: 100%;
                            border-collapse: collapse;
                            border: 1px solid #ccc;
                        }

                        .appointment-table th {
                            background-color: #2a7f9e;
                            color: white;
                            padding: 12px 10px;
                            font-size: 13px;
                            border: 1px solid #236a84;
                        }

                        .appointment-table td {
                            padding: 12px 10px;
                            font-size: 12px;
                            border: 1px solid #eee;
                        }

                        .appointment-table tr:nth-child(even) {
                            background-color: #f9f9f9;
                        }

                        .center { text-align: center; }
                        .right { text-align: right; }
                        .nowrap { white-space: nowrap; }
                    </style>

                    <!-- ✅ HEADER (FIXED) -->
                    <div class="header-box">
                        <table>
                            <tr>

                                <!-- LEFT SIDE -->
                                <td style="
                                    width: 60%;
                                    padding: 12px 15px;
                                    font-size: 22px;
                                    font-weight: bold;
                                    color: #2a7f9e;
                                    text-transform: uppercase;
                                ">
                                    Appointment Summary Report
                                </td>

                                <!-- RIGHT SIDE -->
                                <td style="
                                    width: 40%;
                                    padding: 10px 15px;
                                    font-size: 12px;
                                    text-align: right;
                                ">
                                    <div>
                                        <b>From:</b>
                                        <t t-set="from_dt" t-value="env.context.get('from_date')"/>
                                        <t t-if="from_dt">
                                            <t t-esc="datetime.datetime.strptime(from_dt, '%Y-%m-%d').strftime('%d/%m/%Y')"/>
                                        </t>

                                        <b style="margin-left: 8px;">To:</b>
                                        <t t-set="to_dt" t-value="env.context.get('to_date')"/>
                                        <t t-if="to_dt">
                                            <t t-esc="datetime.datetime.strptime(to_dt, '%Y-%m-%d').strftime('%d/%m/%Y')"/>
                                        </t>
                                    </div>

                                    <div style="margin-top: 4px; color: #666;">
                                        <b>Generated:</b>
                                        <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %I:%M %p')"/>
                                    </div>
                                </td>

                            </tr>
                        </table>
                    </div>

                    <!-- ✅ APPOINTMENT TABLE -->
                    <table class="appointment-table">
                        <thead>
                            <tr>
                                <th class="center" style="width: 5%;">#</th>
                                <th style="width: 10%;">Code</th>
                                <th style="width: 20%;">Patient Name</th>
                                <th style="width: 15%;">Doctor</th>
                                <th class="center" style="width: 12%;">Date</th>
                                <th class="center" style="width: 20%;">Time Slot</th>
                                <th class="right" style="width: 8%;">Fees</th>
                                <th class="center" style="width: 10%;">Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-set="i" t-value="1"/>

                            <t t-foreach="docs" t-as="rec">
                                <tr>
                                    <td class="center">
                                        <t t-esc="i"/>
                                    </td>

                                    <td>
                                        <t t-esc="rec.code"/>
                                    </td>

                                    <td>
                                        <t t-esc="rec.patient_id.name"/>
                                    </td>

                                    <td>
                                        <t t-esc="rec.doctor_id.name"/>
                                    </td>

                                    <td class="center">
                                        <t t-if="rec.start_time"
                                           t-esc="context_timestamp(rec.start_time).strftime('%d/%m/%Y')"/>
                                    </td>

                                    <td class="center nowrap">
                                        <t t-if="rec.start_time"
                                           t-esc="context_timestamp(rec.start_time).strftime('%I:%M %p')"/>
                                        <t t-if="rec.end_time">
                                            - 
                                            <t t-esc="context_timestamp(rec.end_time).strftime('%I:%M %p')"/>
                                        </t>
                                    </td>

                                    <td style="text-align: right; white-space: nowrap;">
                                        <span t-field="rec.fees" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                                    </td>

                                    <td class="center">
                                        <span t-att-style="
                                            'color:' + {
                                                'draft': '#6c757d',
                                                'requested': '#0dcaf0',
                                                'confirmed': '#0d6efd',
                                                'processing': '#ffc107',
                                                'done': '#198754',
                                                'cancel': '#dc3545'
                                            }.get(rec.status, '#000')
                                            + '; font-weight: bold;'
                                        ">
                                            <span t-field="rec.status"/>
                                        </span>
                                    </td>
                                </tr>

                                <t t-set="i" t-value="i + 1"/>
                            </t>

                        </tbody>
                    </table>

                </div>

            </t>
        </t>
    </template>

</odoo>