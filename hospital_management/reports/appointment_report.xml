<odoo>

    <record id="action_appointment_report" model="ir.actions.report" forcecreate="0">
        <field name="name">Appointment Report</field>
        <field name="model">hospital.appointment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hospital_management.report_appointment_pdf</field>
        <field name="report_file">hospital_management.report_hospital_appointment</field>
        <field name="print_report_name"> 'Appointment - %s' % (object.code) </field>

        <field name="binding_model_id" ref="model_hospital_appointment"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">form</field>
    </record>

</odoo>

