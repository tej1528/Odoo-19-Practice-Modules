<odoo>
    <!-- Wizard View -->
        <record id="view_appointment_report_wizard_form" model="ir.ui.view">
        <field name="name">appointment.report.wizard.form</field>
        <field name="model">appointment.report.wizard</field>
        <field name="arch" type="xml">

            <form string="Appointment Report">

            <sheet>

                <group string="Filters" col="2">

                    <!-- LEFT SIDE -->
                    <group>
                        <field name="patient_id"
                            domain="[('is_patient','=',True)]"
                            options="{'no_create': True}"/>

                        <field name="doctor_ids"
                            widget="many2many_tags"
                            domain="[('is_doctor','=',True)]"/>

                        <field name="specialization_ids"
                            widget="many2many_tags"/>
                    </group>

                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>

                </group>

            </sheet>

                <footer>

                    <button name="action_show_data"
                            string="Apply Filters"
                            type="object"
                            class="btn btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>
            </form>
        </field>
    </record>

    <record id="action_appointment_report_wizard" model="ir.actions.act_window">
        <field name="name">Appointment Report</field>
        <field name="res_model">appointment.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>