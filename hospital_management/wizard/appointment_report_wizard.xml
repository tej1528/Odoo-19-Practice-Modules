<odoo>
    <!-- Wizard View -->
        <record id="view_appointment_report_wizard_form" model="ir.ui.view">
        <field name="name">appointment.report.wizard.form</field>
        <field name="model">appointment.report.wizard</field>
        <field name="arch" type="xml">

            <form string="Appointment Report">

            <sheet>

                <group  col="2">

                    <!-- LEFT SIDE -->
                    <group>
                        <field name="patient_ids"
                            widget="many2many_tags"
                            domain="[('is_patient','=',True)]"
                            options="{'no_create': True}"/>

                        <field name="doctor_ids"
                            widget="many2many_tags"
                            domain="[('is_doctor','=',True)]"/>

                        <field name="specialization_ids"
                            widget="many2many_tags"/>
                        <field name="group_by_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>

                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="status_ids"
                            widget="many2many_tags"
                            options="{'no_create': True}"/>
                        
                    </group>

                </group>

            </sheet>

                <footer>

                    <button name="action_show_data"
                            string="Apply Filters"
                            type="object"
                            class="btn btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                    <button name="action_print_pdf"
                            string="Print PDF"
                            type="object"
                            class="btn-primary"/>

                </footer>
            </form>
        </field>
    </record>

    <!-- actions -->
    <record id="action_appointment_report_wizard" model="ir.actions.act_window">
        <field name="name">Appointment Report</field>
        <field name="res_model">appointment.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_appointment_report_pdf" model="ir.actions.report">
        <field name="name">Appointment Report</field>
        <field name="model">hospital.appointment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hospital_management.report_appointment_pdf</field>
        <field name="report_file">hospital_management.report_appointment_pdf</field>
    </record>
</odoo>