<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- CONFIRM -->
        <record id="email_template_confirm" model="mail.template">
            <field name="name">Appointment Confirm</field>
            <field name="model_id" ref="hospital_management.model_hospital_appointment"/>
            <field name="email_from">{{ (user.email_formatted) }}</field>
            <field name="partner_to">{{ object.patient_id.email }}</field>
            <field name="subject">Appointment Confirm - {{ object.code }}</field>

            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-esc="object.patient_id.name"/></p>

                    <p>Your appointment is <b>CONFIRMED</b>.</p>

                    <ul>
                        <li>Doctor: <t t-esc="object.doctor_id.name"/></li>
                        <li>Start: <t t-esc="object.start_time"/></li>
                        <li>End: <t t-esc="object.end_time"/></li>
                        <li>Fees: <t t-esc="object.fees"/></li>
                    </ul>

                    <p>Thank you</p>
                </div>
            </field>
        </record>

        <!-- CANCEL -->
        <record id="email_template_cancel" model="mail.template">
            <field name="name">Appointment Cancel</field>
            <field name="model_id" ref="hospital_management.model_hospital_appointment"/>

            <field name="email_to">{{ object.patient_id.email }}</field>

            <field name="subject">
                Appointment Cancelled - {{ object.code }}
            </field>

            <field name="email_from">workwithme5001@gmail.com</field>

            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-esc="object.patient_id.name"/></p>

                    <p>Your appointment is <b>CANCELLED</b>.</p>

                    <p>Thank you</p>
                </div>
            </field>
        </record>

    </data>
</odoo>