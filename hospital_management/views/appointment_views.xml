<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ===================== -->
        <!-- SEQUENCE -->
        <!-- ===================== -->
        <record id="seq_appointment_code" model="ir.sequence">
            <field name="name">Appointment Code</field>
            <field name="code">appointment.code</field>
            <field name="prefix">APT</field>
            <field name="padding">4</field>
        </record>

        <!-- ===================== -->
        <!-- LIST VIEW -->
        <!-- ===================== -->
        <record id="view_appointment_list" model="ir.ui.view">
            <field name="name">hospital.appointment.list</field>
            <field name="model">hospital.appointment</field>
            <field name="arch" type="xml">
                <list>
                    <field name="code"/>
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="specialization_id"/>
                    <field name="start_time"/>
                    <field name="end_time"/>
                    <field name="fees" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="status"/>
                </list>
            </field>
        </record>

        <!-- ===================== -->
        <!-- FORM VIEW -->
        <!-- ===================== -->
        <record id="view_appointment_form" model="ir.ui.view">
            <field name="name">hospital.appointment.form</field>
            <field name="model">hospital.appointment</field>
            <field name="arch" type="xml">
                
                <!--  IMPORTANT CLASS ADDED -->
                <form string="Appointment" class="o_form_view o_xxl_form_view">

                    <!-- HEADER -->
                    <header>

                        <button name="action_requested"
                                string="Request"
                                type="object"
                                class="btn-primary"
                                invisible="status != 'draft'"/>

                        <button name="action_confirm"
                                string="Accept"
                                type="object"
                                class="btn-success"
                                invisible="status != 'requested'"/>

                        <button name="action_processing"
                                string="Start Processing"
                                type="object"
                                class="btn-primary"
                                invisible="status != 'confirmed'"/>

                        <button name="action_done"
                                string="Done"
                                type="object"
                                class="btn-success"
                                invisible="status != 'processing'"/>

                        <button name="action_cancel"
                                string="Cancel"
                                type="object"
                                class="btn-danger"
                                invisible="status != 'requested' and status != 'confirmed'"/>

                        <button name="action_reset_to_draft"
                                string="Reset to Draft"
                                type="object"
                                class="btn-secondary"
                                invisible="status != 'cancel'"/>
                        
                        <field name="status"
                               widget="statusbar"
                               statusbar_visible="draft,requested,confirmed,processing,done,cancel"/>

                    </header>

                    <!-- MAIN CONTENT (UNCHANGED) -->
                    <sheet>

                        <group>
                            <h1>
                                <field name="code" readonly="1"/>
                            </h1>
                        </group>

                        <group string="Appointment Details" col="2">

                            <group>
                                <field name="patient_id"/>
                                <field name="doctor_id"/>
                                <field name="specialization_id"/>
                            </group>

                            <group>
                                <field name="start_time"/>
                                <field name="end_time"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="fees" widget="monetary"/>
                            </group>

                        </group>

                        <group string="Notes">
                            <field name="notes" colspan="2" nolabel="1"/>
                        </group>

                        <group string="Doctor Notes" invisible="status != 'processing' and status != 'done'">
                            <field name="doctor_description"
                                nolabel="1"
                                readonly="status == 'done'" />
                        </group>

                        <group string="Cancel Reason"
                            invisible="status != 'cancel'">
                            <field name="cancel_reason" readonly="1" nolabel="1"/>
                        </group>

                    
                    </sheet>
                    <!--  RIGHT SIDE CHATTER -->
                    <chatter>
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </chatter>
                    

                </form>

            </field>
        </record>
        <record id="view_cancel_wizard_form" model="ir.ui.view">
    <field name="name">appointment.cancel.wizard.form</field>
    <field name="model">appointment.cancel.wizard</field>
    <field name="arch" type="xml">
        <form string="Cancel Appointment">
            <group>
                <field name="appointment_id" invisible="1"/>
                <field name="reason"/>
            </group>
            <footer>
                <button name="action_confirm_cancel"
                        type="object"
                        string="Confirm"
                        class="btn-primary"/>
                <button string="Close" special="cancel"/>
            </footer>
        </form>
    </field>
</record>

    </data>
</odoo>