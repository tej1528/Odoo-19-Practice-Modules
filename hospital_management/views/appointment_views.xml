<odoo>
    <data>

        <!-- Appointment Sequence -->
        <record id="seq_appointment_code" model="ir.sequence">
            <field name="name">Appointment Code</field>
            <field name="code">appointment.code</field>
            <field name="prefix">APT</field>
            <field name="padding">4</field>
        </record>

        <!-- Appointment List View -->
        <record id="view_appointment_list" model="ir.ui.view">
            <field name="name">hospital.appointment.list</field>
            <field name="model">hospital.appointment</field>
            <field name="arch" type="xml">
                <list>
                    <field name="code"/>
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="specialization_id"/>
                    <field name="start_time"/>
                    <field name="end_time"/>
                    <field name="fees" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="status"/>
                </list>
            </field>
        </record>

        <!-- Appointment Form View -->
        <record id="view_appointment_form" model="ir.ui.view">
            <field name="name">hospital.appointment.form</field>
            <field name="model">hospital.appointment</field>
            <field name="arch" type="xml">
                <form string="Appointment">

                    <header>

                        <!-- REQUEST -->
                        <button name="action_requested"
                                string="Request"
                                type="object"
                                class="btn-primary"
                                invisible="status != 'draft'"/>

                        <!-- ACCEPT -->
                        <button name="action_confirm"
                                string="Accept"
                                type="object"
                                class="btn-success"
                                invisible="status != 'requested' or not is_doctor_user"
                                groups="base.group_user"/>

                        <!-- DONE -->
                        <button name="action_done"
                                string="Done"
                                type="object"
                                class="btn-success"
                                invisible="status != 'confirmed'"/>

                        <!-- CANCEL -->
                        <button name="action_cancel"
                                string="Cancel"
                                type="object"
                                class="btn-danger"
                                invisible="status not in ['requested','confirmed']"/>

                        <field name="status"
                               widget="statusbar"
                               statusbar_visible="draft,requested,confirmed,done,cancel"/>

                    </header>

                    <sheet>

                        <group>
                            <h1 style="color:#198754; font-weight:bold;">
                                <field name="code" readonly="1"/>
                            </h1>
                        </group>

                        <group string="Appointment Details" col="2">

                            <group>
                                <field name="patient_id"/>
                                <field name="doctor_id"/>
                                <field name="specialization_id"/>
                                <field name="is_doctor_user"/>
                            </group>

                            <group>
                                <field name="start_time"/>
                                <field name="end_time"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="fees" widget="monetary"/>
                            </group>

                        </group>

                        <group string="Notes">
                            <field name="notes" colspan="2"/>
                        </group>

                        <group string="Cancel Reason" invisible="status != 'cancel'">
                            <field name="cancel_reason" readonly="1"/>
                        </group>

                    </sheet>

                </form>
            </field>
        </record>

    </data>
</odoo>