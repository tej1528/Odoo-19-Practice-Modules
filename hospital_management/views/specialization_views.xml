<odoo>
    <!-- LIST VIEW -->
    <!-- ===================== -->
    <record id="view_specialization_list" model="ir.ui.view">
        <field name="name">hospital.specialization.list</field>
        <field name="model">hospital.specialization</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <!-- ===================== -->
    <record id="view_specialization_form" model="ir.ui.view">
        <field name="name">hospital.specialization.form</field>
        <field name="model">hospital.specialization</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Enter Specialization"/>
                        </h1>
                    </div>

                    <div class="oe_button_box" name="button_box">

                        <button name="action_view_doctors"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-user-md"
                                invisible="doctor_count == 0">
                            <field name="doctor_count" widget="statinfo" string="Doctors"/>
                        </button>

                        <button name="action_view_patients"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-user"
                                invisible="patient_count == 0">
                            <field name="patient_count" widget="statinfo" string="Patients"/>
                        </button>

                    </div>

                </sheet>            
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <!-- ===================== -->
    <record id="action_specialization" model="ir.actions.act_window">
        <field name="name">Specializations</field>
        <field name="res_model">hospital.specialization</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>