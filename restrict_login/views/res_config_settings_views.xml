<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_restrict_login"
            model="ir.ui.view">

        <field name="name">res.config.settings.restrict.login</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>

        <field name="arch" type="xml">

            <xpath expr="//app[@name='general_settings']"
                   position="inside">

                <block title="Login Security">

                    <setting string="Restrict Multiple Login">
                        <field name="restrict_multiple_login"/>
                    </setting>

                    <setting string="Force New Login">
                        <field name="force_new_login"/>
                    </setting>

                </block>

            </xpath>

        </field>

    </record>

</odoo>