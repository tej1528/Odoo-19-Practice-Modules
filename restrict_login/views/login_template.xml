<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="restrict_login_checkbox" inherit_id="web.login">
        <xpath expr="//button[@type='submit']" position="before">
            <t t-if="show_force_login_checkbox">
                <div class="form-check mb-3">
                    <input type="checkbox" class="form-check-input" id="force_login" name="force_login"/>
                    <label class="form-check-label" for="force_login">
                        Logout active session and continue login
                    </label>
                </div>
            </t>
            <t t-if="login_blocked">
                <input type="hidden" id="remaining_seconds" t-att-value="remaining_seconds"/>
                <div class="alert alert-danger mt-2">
                    Maximum login attempts reached. Try again after 
                    <span id="countdown_timer"><t t-esc="remaining_seconds"/> second(s)</span>
                </div>
            </t>
        </xpath>
    </template>
</odoo>