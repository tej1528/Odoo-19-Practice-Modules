<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_invoice_hide_tax"
              inherit_id="account.report_invoice_document">

        <!-- Hide Taxes column header -->
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="t-if">
                display_taxes and not request.env.user.has_group('Hide_Tax_from_Invoice.group_hide_tax')
            </attribute>
        </xpath>

        <!-- Hide Taxes column value -->
        <xpath expr="//td[@name='td_taxes']" position="attributes">
            <attribute name="t-if">
                display_taxes and not request.env.user.has_group('Hide_Tax_from_Invoice.group_hide_tax')
            </attribute>
        </xpath>
    </template>

    <template id="document_tax_totals_hide_tax" inherit_id="account.document_tax_totals_template">
        <xpath expr="//t[@t-as='tax_group']" position="attributes">
            <attribute name="t-if">
                not request.env.user.has_group('Hide_Tax_from_Invoice.group_hide_tax')
            </attribute>
        </xpath>
    </template>
</odoo>