<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_hide_tax" model="ir.ui.view">
        <field name="name">res.config.settings.hide.tax</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//setting[@id='default_taxes']/div[@class='content-group']"
                   position="inside">

                <div class="row mt16">
                    <label for="hide_tax" class="col-lg-3 o_light_label"/>
                    <field name="hide_tax"/>
                </div>

            </xpath>

        </field>
    </record>

</odoo>