<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_hide_tax" model="ir.ui.view">
        <field name="name">account.move.form.hide.tax</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='tax_ids']" position="attributes">
                 <attribute name="groups">!Hide_Tax_from_Invoice.group_hide_tax</attribute>
            </xpath>        
        </field>
    </record>

    <record id="view_move_list_hide_tax" model="ir.ui.view">
        <field name="name">account.move.list.hide.tax</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='amount_tax_signed']" position="attributes">
                <attribute name="groups">!Hide_Tax_from_Invoice.group_hide_tax</attribute>
            </xpath>
        </field>
    </record>
</odoo>