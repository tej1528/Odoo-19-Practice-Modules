<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_hide_tax" model="ir.ui.view">
        <field name="name">account.move.form.hide.tax</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Hidden helper field -->
            <xpath expr="//sheet" position="inside">
                <field name="hide_tax" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='tax_ids']"
                position="attributes">
                <attribute name="column_invisible">parent.hide_tax</attribute>
            </xpath>
        </field>
    </record>

</odoo>