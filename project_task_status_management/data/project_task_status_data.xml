<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <record id="task_status_in_process" model="project.task.status">
        <field name="name">IN PROCESS</field>
        <field name="sequence">1</field>
        <field name="icon">play</field>
        <field name="icon_color">secondary</field>
        <field name="active">True</field>
    </record>

    <record id="task_status_approved" model="project.task.status">
        <field name="name">APPROVED</field>
        <field name="sequence">2</field>
        <field name="icon">check</field>
        <field name="icon_color">success</field>
        <field name="active">True</field>
    </record>

    <record id="task_status_change_requested" model="project.task.status">
        <field name="name">CHANGE REQUESTED</field>
        <field name="sequence">3</field>
        <field name="icon">pause</field>
        <field name="icon_color">warning</field>
        <field name="active">True</field>
    </record>

    <record id="task_status_done" model="project.task.status">
        <field name="name">DONE</field>
        <field name="sequence">4</field>
        <field name="icon">circle</field>
        <field name="icon_color">success</field>
        <field name="active">True</field>
    </record>

    <record id="task_status_cancel" model="project.task.status">
        <field name="name">CANCLE</field>
        <field name="sequence">5</field>
        <field name="icon">times</field>
        <field name="icon_color">danger</field>
        <field name="active">True</field>
    </record>

</odoo>