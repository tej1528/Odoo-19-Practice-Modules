<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_reject_wizard_form" model="ir.ui.view">
        <field name="name">project.task.reject.wizard.form</field>
        <field name="model">project.task.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Task">
                <group>
                    <field name="reason" placeholder="Enter reason for rejection..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Submit Rejection" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>