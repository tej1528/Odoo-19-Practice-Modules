<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_project_task_type_form_inherit_transition" model="ir.ui.view">
        <field name="name">project.task.type.form.inherit.transition</field>
        <field name="model">project.task.type</field>
        <field name="inherit_id" ref="project.task_type_edit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_ids']" position="after">
                <field name="allowed_next_stage_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="allow_manager_bypass"/>
                <field name="allowed_status_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="default_user_id"/>
            </xpath>
        </field>
    </record>
    <record id="view_project_task_type_form_inherit_approval" model="ir.ui.view">
        <field name="name">project.task.type.form.inherit.approval</field>
        <field name="model">project.task.type</field>
        <field name="inherit_id" ref="project.task_type_edit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_user_id']" position="after">
                <field name="approved_user_id"/>
            </xpath>
        </field>
    </record>
</odoo>