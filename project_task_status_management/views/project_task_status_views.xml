<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_project_task_status_list" model="ir.ui.view">
        <field name="name">project.task.status.list</field>
        <field name="model">project.task.status</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="icon"/>
                <field name="icon_color"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_project_task_status_form" model="ir.ui.view">
        <field name="name">project.task.status.form</field>
        <field name="model">project.task.status</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="icon"/>
                            <field name="icon_color"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_project_task_status" model="ir.actions.act_window">
        <field name="name">Task Status</field>
        <field name="res_model">project.task.status</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_project_task_status"
        name="Task Statuses"
        parent="project.menu_project_config"
        action="action_project_task_status"
        sequence="50"
    />
</odoo>