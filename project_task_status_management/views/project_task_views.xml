<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="project_task_form_status" model="ir.ui.view">
        <field name="name">project.task.form.status</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class,'o_state_container')]/field[@name='state']" position="replace">
                <field name="stage_id" invisible="1"/>
                <field name="status_id" widget="status_selection" class="o_task_state_widget" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
    <record id="project_task_form_approval" model="ir.ui.view">
        <field name="name">project.task.form.approval</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="approval_state" invisible="1"/>
                <field name="is_approval_manager" invisible="1"/>
                
                <!-- Approve Button: માત્ર મેનેજર હોય અને Pending હોય ત્યારે જ દેખાશે -->
                <button name="action_approve_task" 
                        string="Approve" 
                        type="object" 
                        class="oe_highlight btn-success" 
                        invisible="approval_state != 'pending' or not is_approval_manager"/>
                
                <!-- Reject Button: માત્ર મેનેજર હોય અને Pending હોય ત્યારે જ દેખાશે -->
                <button name="action_reject_task_wizard" 
                        string="Reject" 
                        type="object" 
                        class="btn-danger" 
                        invisible="approval_state != 'pending' or not is_approval_manager"/>
            </xpath>

            <xpath expr="//sheet" position="before">
                <field name="rejection_reason" invisible="1"/>
                <div class="alert alert-danger mb-2" role="alert" invisible="approval_state != 'rejected'">
                    <strong>Task Rejected!</strong> Reason: <field name="rejection_reason" readonly="1"/>
                </div>
                <div class="alert alert-warning mb-2" role="alert" invisible="approval_state != 'pending'">
                    <strong>Pending Approval:</strong> Waiting for manager approval to change stage.
                </div>
            </xpath>
        </field>
    </record>
</odoo>