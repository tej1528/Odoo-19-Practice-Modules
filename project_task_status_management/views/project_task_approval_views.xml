<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_task_approval_list" model="ir.ui.view">
        <field name="name">project.task.approval.list</field>
        <field name="model">project.task.approval</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="task_id"/>
                <field name="requested_by"/>
                <field name="approver_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_project_task_approval_form" model="ir.ui.view">
        <field name="name">project.task.approval.form</field>
        <field name="model">project.task.approval</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="task_id"/>
                        <field name="requested_by"/>
                        <field name="approver_id"/>
                        <field name="current_stage_id"/>
                        <field name="requested_stage_id"/>
                        <field name="state"/>
                        <field name="rejection_reason"/>
                    </group>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

</odoo>