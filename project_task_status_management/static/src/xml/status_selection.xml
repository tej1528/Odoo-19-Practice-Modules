<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="project_task_status_management.StatusSelection">
        <div class="custom_state_selection_container dropdown d-inline-block align-middle">
            <button
                type="button"
                class="custom_status_bubble btn d-inline-flex align-items-center justify-content-center text-nowrap"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                t-att-data-color="state.currentStatus ? state.currentStatus.icon_color : 'secondary'"
                t-att-style="state.currentStatus ? ('--status-color:' + colorMap(state.currentStatus.icon_color)) : '--status-color: #6C757D;'">
                
                <t t-if="state.currentStatus">
                    <span t-esc="state.currentStatus.name" class="status-btn-text" />
                </t>
                <t t-else="">
                    <span class="status-btn-text text-muted">Select Status</span>
                </t>
            </button>

            <ul class="dropdown-menu border-0 shadow-sm rounded-3 mt-1 py-1">
                <t t-foreach="state.statuses" t-as="status" t-key="status.id">
                    <t t-if="dividerStatusId === status.id and !status_first">
                        <li class="dropdown-divider border-top my-1" style="border-color: rgba(0, 0, 0, 0.08) !important;"/>
                    </t>
                    <li>
                        <a href="#" class="dropdown-item d-flex align-items-center py-2 px-3" t-att-data-id="status.id" t-on-click.prevent="selectStatus">
                            <t t-if="state.currentStatus and state.currentStatus.id == status.id">
                                <i class="fa fa-check text-primary me-2" style="font-size: 11px;"/>
                            </t>
                            <t t-else="">
                                <span style="width: 14px;" class="me-2"></span>
                            </t>
                            <span class="status-icon-wrapper me-2" t-att-style="'color:' + colorMap(status.icon_color)">
                                <i t-attf-class="fa {{ iconMap(status.icon) }}" />
                            </span>
                            <span t-esc="status.name" class="dropdown-status-text" t-att-style="'color:' + colorMap(status.icon_color)"/>
                        </a>
                    </li>
                </t>
            </ul>
        </div>
    </t>
</templates>