<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="project_task_status_management.StatusSelection">

        <div class="dropdown d-inline-block align-middle">

            <!-- Status Button -->
            <button
                type="button"
                class="btn btn-light custom-status-btn dropdown-toggle"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                t-att-style="currentStatus ? ('background-color:' + bgColorMap(currentStatus.icon_color)) : 'background-color:#f1f2f4;'">

                <t t-if="currentStatus">

                    <!-- Status Icon -->
                    <span
                        class="status-icon-wrapper"
                        t-att-style="'color:' + colorMap(currentStatus.icon_color)">
                        <i t-att-class="iconClass(currentStatus.icon)"/>
                    </span>

                    <!-- Status Name -->
                    <span
                        class="status-btn-text"
                        t-att-style="'color:' + colorMap(currentStatus.icon_color)"
                        t-esc="currentStatus.name"/>

                </t>

                <t t-else="">
                    <span class="status-btn-text text-muted">
                        Select Status
                    </span>
                </t>

                <i class="fa fa-caret-down text-muted ms-1"/>

            </button>

            <!-- Dropdown -->
            <ul class="dropdown-menu mt-1">

                <t
                    t-foreach="statuses"
                    t-as="status"
                    t-key="status.id">

                    <li>

                        <a
                            href="#"
                            class="dropdown-item d-flex align-items-center"
                            t-att-data-id="status.id"
                            t-on-click.prevent="selectStatus">

                            <!-- Selected Tick -->
                            <t t-if="currentStatus and currentStatus.id == status.id">
                                <i class="fa fa-check text-primary me-2"/>
                            </t>
                            <t t-else="">
                                <span class="me-2" style="width:14px;"/>
                            </t>

                            <!-- Status Icon -->
                            <span
                                class="status-icon-wrapper me-2"
                                t-att-style="'color:' + colorMap(status.icon_color)">
                                <i t-att-class="iconClass(status.icon)"/>
                            </span>

                            <!-- Status Name -->
                            <span
                                class="dropdown-status-text"
                                t-att-style="'color:' + colorMap(status.icon_color)"
                                t-esc="status.name"/>
                        </a>
                    </li>
                </t>
            </ul>
        </div>
    </t>
</templates>