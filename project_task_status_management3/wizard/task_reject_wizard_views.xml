<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form -->
    <record id="view_task_reject_wizard_form" model="ir.ui.view">
        <field name="name">task.reject.wizard.form</field>
        <field name="model">task.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Task Approval">

                <group>
                    <field name="task_id" readonly="1"/>
                    <field name="reason"
                           placeholder="Enter rejection reason..."/>
                </group>

                <footer>

                    <button
                        name="action_reject"
                        string="Reject"
                        type="object"
                        class="btn btn-danger"/>

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn btn-secondary"/>

                </footer>

            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_task_reject_wizard" model="ir.actions.act_window">
        <field name="name">Reject Task</field>
        <field name="res_model">task.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_task_reject_wizard_form"/>
    </record>

</odoo>